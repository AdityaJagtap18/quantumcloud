# Copy to .env for local Docker Compose use.
APP_NAME=QuantumCloud
ENVIRONMENT=development

# Docker Compose service hostnames
DATABASE_URL=postgresql+psycopg2://quantumcloud:quantumcloud@postgres:5432/quantumcloud
REDIS_URL=redis://redis:6379/0

# Generate a real secret for production, e.g.: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

MAX_QUBITS_STATEVECTOR=20
MAX_QUBITS_SHOTS=30
MAX_SHOTS=100000
JOB_EXECUTION_TIMEOUT_SECONDS=60

RATE_LIMIT_REQUESTS_PER_MINUTE=120

# Postgres container credentials (used by docker-compose.yml, must match DATABASE_URL above)
POSTGRES_USER=quantumcloud
POSTGRES_PASSWORD=quantumcloud
POSTGRES_DB=quantumcloud
